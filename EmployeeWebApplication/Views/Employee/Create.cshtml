@model EmployeeWebApplication.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container py-5">

    <!-- Header Section -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Create New Employee</h2>
        <p class="text-muted">Enter employee details and save to the system</p>
    </div>

    <!-- Card Layout -->
    <div class="card border-0 shadow rounded-4">
        <div class="card-body p-5">

            <form asp-action="Create" method="post" novalidate>

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger d-none"
                     id="validationSummary">
                </div>

                <div class="row">

                    <!-- First Name -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control form-control-lg" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <!-- Last Name -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control form-control-lg" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control form-control-lg" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control form-control-lg" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Gender" class="form-label fw-semibold"></label>
                        <select asp-for="Gender" class="form-select form-select-lg">
                            <option value="">Select Gender</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>

                    <!-- City -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control form-control-lg" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <!-- Department -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <input asp-for="Department" class="form-control form-control-lg" />
                    </div>

                    <!-- Year Of Joining -->
                    <div class="col-md-6 mb-4">
                        <label asp-for="YearOfJoining" class="form-label fw-semibold"></label>
                        <input asp-for="YearOfJoining" class="form-control form-control-lg" />
                    </div>

                    <!-- Address -->
                    <div class="col-12 mb-4">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <textarea asp-for="Address"
                                  class="form-control form-control-lg"
                                  rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary me-3 px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-5 shadow-sm">
                        Save Employee
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}