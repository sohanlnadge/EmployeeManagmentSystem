@model EmployeeWebApplication.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container py-5">

    <!-- Header Section -->
    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Employee</h2>
        <p class="text-muted mb-0">
            Please review the employee information before confirming deletion.
        </p>
    </div>

    <!-- Card -->
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-5">

            <!-- Warning Alert -->
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <div>
                    <strong>Warning:</strong> This action cannot be undone.
                    Are you sure you want to permanently delete this employee record?
                </div>
            </div>

            <!-- Employee Details -->
            <h5 class="fw-semibold mb-4 border-bottom pb-2">
                Employee Information
            </h5>

            <dl class="row mb-4">

                <dt class="col-sm-3 fw-semibold">Full Name</dt>
                <dd class="col-sm-9">
                    @Model.FirstName @Model.LastName
                </dd>

                <dt class="col-sm-3 fw-semibold">Email</dt>
                <dd class="col-sm-9">
                    @Model.Email
                </dd>

                <dt class="col-sm-3 fw-semibold">Department</dt>
                <dd class="col-sm-9">
                    @Model.Department
                </dd>

            </dl>

            <!-- Action Buttons -->
            <form asp-action="Delete" method="post" class="d-flex justify-content-end">
                <input type="hidden" asp-for="EmployeeId" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4 me-3">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger px-5 shadow-sm">
                    Yes, Delete
                </button>
            </form>

        </div>
    </div>

</div>