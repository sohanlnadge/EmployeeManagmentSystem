  @model IEnumerable<EmployeeWebApplication.Models.Employee>

@{
    var totalEmployees = Model?.Count() ?? 0;
}



    <!-- Top Section -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1">Employee Management</h2>
            <p class="text-muted">Overview and management of company employees</p>
        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
                + Add Employee
            </a>
        </div>
    </div>

    <!-- Stats Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h6 class="text-muted mb-1">Total Employees</h6>
                <h3 class="fw-bold">@totalEmployees</h3>
            </div>
            <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                <i class="bi bi-people-fill text-primary fs-4"></i>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow rounded-4">
        <div class="card-body p-4">

            <!-- Search Bar UI -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <input type="text" class="form-control"
                           placeholder="Search employee... (UI only)">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">

                    <thead class="border-bottom">
                        <tr class="text-muted small text-uppercase">
                            <th>Employee</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var emp in Model)
                            {
                                var initials = $"{emp.FirstName?[0]}{emp.LastName?[0]}";

                                <tr class="border-bottom">

                                    <!-- Employee Info -->
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary text-white
                                                                d-flex align-items-center justify-content-center
                                                                me-3"
                                                 style="width:40px;height:40px;">
                                                @initials
                                            </div>
                                            <div>
                                                <div class="fw-semibold">
                                                    @emp.FirstName @emp.LastName
                                                </div>
                                                <small class="text-muted">
                                                    ID: @emp.EmployeeId
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="text-muted">
                                        @emp.Email
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            @emp.Department
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-secondary me-2">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-primary me-2">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@emp.EmployeeId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    No employee records available.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
