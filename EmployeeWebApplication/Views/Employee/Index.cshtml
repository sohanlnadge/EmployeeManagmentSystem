@model IEnumerable<EmployeeWebApplication.Models.Employee>

<div class="card card-success">

    <!-- CARD HEADER -->
    <div class="card-header">
        <h3 class="card-title">Employee List</h3>

        <div class="card-tools">
            <a asp-action="Create" class="btn btn-dark btn-sm">
                <i class="fas fa-plus"></i> Add Employee
            </a>

            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>

            <button type="button" class="btn btn-tool" data-card-widget="remove">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>

    <!-- CARD BODY -->
    <div class="card-body table-responsive p-0">

        @{
            int srNo = 1;
        }

        <table class="table table-hover text-nowrap">
            <thead class="table-dark">
                <tr>
                    <th>Sr. No.</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Department</th>
                    <th>City</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@srNo</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Department</td>
                            <td>@item.City</td>

                            <td>
                                <a asp-action="Details" asp-route-id="@item.EmployeeId"
                                   class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.EmployeeId"
                                   class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.EmployeeId"
                                   class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        srNo++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No employees found
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

    <!-- CARD FOOTER -->
    <div class="card-footer clearfix">
        <span class="text-muted">
            Total Employees: @Model?.Count()
        </span>
    </div>

</div>